#: src/event-list.c:1499
msgid ""
"Double click line to edit it.\n"
"\n"
"<b>Flags in order:</b>\n"
"1. Alarm:\n"
"   n = no alarm, A = alarm is set, P = persistent alarm is set\n"
"2. Recurrence:\n"
"   n = no recurrence, H = hourly, D = daily, W = weekly, M = monthly, Y = yearly\n"
"3. Type:\n"
"   f = free, B = busy\n"
"4. Located in file:\n"
"   O = Orage, A = archive, F = foreign\n"
"5. Appointment type:\n"
"   E = event, T = todo, J = journal"
msgstr ""
"Veiciet dubultklikšķi uz rindas, lai to rediģētu.\n"
"\n"
"<b>Karodziņi secībā:</b>\n"
"1. Atgādinājums:\n"
"   n = nav atgādinājuma, A = iestatīts atgādinājums, P = iestatīts pastāvīgs atgādinājums\n"
"2. Atkārtošanās:\n"
"   n = neatkārtojas, H = katru stundu, D = katru dienu, W = katru nedēļu, M = katru mēnesi, Y = katru gadu\n"
"3. Tips:\n"
"   f = brīvs, B = aizņemts\n"
"4. Atrodas failā:\n"
"   O = Orage, A = arhīvs, F = ārējs\n"
"5. Tikšanās tips:\n"
"   E = notikums, T = uzdevums, J = žurnāls"

